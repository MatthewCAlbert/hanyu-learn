# Public — Vite inlines this into the client bundle. Not a secret.
# Directory that contains hsk/ and syllabs/ (audio-cmn 24k-abr layout).
# The host must send Access-Control-Allow-Origin (jsDelivr does).
# Leave unset to use the browser's zh-CN speechSynthesis instead.
#
# CDN_AUDIO_URL=https://cdn.example.com/audio

# Upload-only (`pnpm data:audio:upload`). Never prefixed VITE_ or CDN_ — not in the client.
# AUDIO_S3_ENDPOINT is the S3-compatible API origin (MinIO, R2, Garage, AWS, …).
# Default addressing is path-style: {endpoint}/{bucket}/hsk/… and {endpoint}/{bucket}/syllabs/…
# AUDIO_S3_ENDPOINT=https://s3.example.com
# AUDIO_S3_BUCKET=mandarin-audio
# AUDIO_S3_REGION=us-east-1
# AUDIO_S3_ADDRESSING=path
# AUDIO_S3_ACCESS_KEY_ID=
# AUDIO_S3_SECRET_ACCESS_KEY=
# AUDIO_S3_PREFIX=
# AUDIO_S3_ACL=
