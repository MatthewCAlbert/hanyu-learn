{
  "name": "mandarin-1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/ensure-dataset.ts && react-router dev",
    "dev:ssl": "tsx scripts/ensure-dataset.ts && DEV_SSL=1 react-router dev",
    "build": "tsx scripts/ensure-dataset.ts && react-router build",
    "start": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:tatoeba": "tsx scripts/prepare-tatoeba.ts",
    "data:audio": "tsx scripts/prepare-audio.ts",
    "data:audio:upload": "tsx scripts/upload-audio.ts",
    "data:build": "tsx scripts/build-dataset.ts",
    "data:md": "tsx scripts/build-md-lists.ts",
    "check:content": "tsx scripts/check-content.ts",
    "format": "prettier --write .",
    "prepare": "tsx scripts/ensure-dataset.ts"
  },
  "dependencies": {
    "@openrouter/agent": "0.11.0",
    "clsx": "^2.1.1",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "idb": "^8.0.3",
    "isbot": "^5.2.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "react-virtuoso": "^4.18.13",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
