# Same as .gitignore — the CLI may skip .gitignore when the repo has no commits.
node_modules
.pnpm-store
/build
/.react-router
.DS_Store
*.local
/data/sources/.raw
/app/data/generated
/public/data
.vercel

# Recorded clips — not committed. Serve from CDN_AUDIO_URL, or leave unset for TTS.
/data/sources/audio-cmn/**/*.mp3

# Not needed to build or run the app on Vercel.
.claude
/docs
/tests
.env